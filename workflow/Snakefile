else:
    _mix_method_val = str(_mix_method_cfg).lower()
    MIX_METHODS = ["nnls", "bayesian"] if _mix_method_val == "both" else [_mix_method_val]

_allowed_mix_methods = {"nnls", "bayesian"}
if not set(MIX_METHODS).issubset(_allowed_mix_methods):
    raise ValueError(
        "mixture.method must be one of 'nnls', 'bayesian', 'both', "
        "or a list containing only 'nnls'/'bayesian'."
    )

