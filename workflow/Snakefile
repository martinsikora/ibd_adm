    config.get("mixture", {}).get("auto_source_max_per_broad_clade", 1)
)
if MIX_AUTO_SOURCE_MAX_PER_BROAD_CLADE < 1:
    raise ValueError("mixture.auto_source_max_per_broad_clade must be >= 1")
MIX_AUTO_SOURCE_MIN_TREE_DIST_QUANTILE = float(
    config.get("mixture", {}).get("auto_source_min_tree_dist_quantile", 0.0)
)
if MIX_AUTO_SOURCE_MIN_TREE_DIST_QUANTILE < 0 or MIX_AUTO_SOURCE_MIN_TREE_DIST_QUANTILE > 1:
    raise ValueError("mixture.auto_source_min_tree_dist_quantile must be in [0, 1]")
MIX_AUTO_SOURCE_LABEL_PREFIX_PARTS = int(
    config.get("mixture", {}).get("auto_source_label_prefix_parts", 0)
)
MIX_AUTO_SOURCE_MAX_PER_LABEL_PREFIX = int(
    config.get("mixture", {}).get("auto_source_max_per_label_prefix", 0)
)
if MIX_AUTO_SOURCE_LABEL_PREFIX_PARTS < 0 or MIX_AUTO_SOURCE_MAX_PER_LABEL_PREFIX < 0:
    raise ValueError("mixture.auto_source_label_prefix_parts and auto_source_max_per_label_prefix must be >= 0")
# for source_pick_method differentiated / differentiated_spread
MIX_AUTO_SOURCE_MIN_CLUSTER_SIZE = int(
    config.get("mixture", {}).get("auto_source_min_cluster_size", 1)
)
if MIX_AUTO_SOURCE_MIN_CLUSTER_SIZE < 1:
    raise ValueError("mixture.auto_source_min_cluster_size must be >= 1")
# store_true flag -> a shell fragment (present when true, empty when false)
MIX_AUTO_SOURCE_RELATIVE_PENDANT = (
    "--source_relative_pendant"
    if bool(config.get("mixture", {}).get("auto_source_relative_pendant", False))
    else ""
)
# for source_pick_method differentiated_unadmixed: admixture (betweenness) screen
MIX_AUTO_SOURCE_ADMIX_SLACK_QUANTILE = float(
    config.get("mixture", {}).get("auto_source_admix_slack_quantile", 0.5)
)
if MIX_AUTO_SOURCE_ADMIX_SLACK_QUANTILE < 0 or MIX_AUTO_SOURCE_ADMIX_SLACK_QUANTILE > 1:
    raise ValueError("mixture.auto_source_admix_slack_quantile must be in [0, 1]")
MIX_AUTO_SOURCE_DRIFT_WEIGHT = float(
    config.get("mixture", {}).get("auto_source_drift_weight", 0.5)
)
if MIX_AUTO_SOURCE_DRIFT_WEIGHT < 0:
    raise ValueError("mixture.auto_source_drift_weight must be >= 0")

PEAK_CFG = config.get("ibd_window_peaks", {})
PEAK_ENABLED = bool(PEAK_CFG.get("enabled", False))
PEAK_WINDOW_SIZE = int(PEAK_CFG.get("window_size", 10000))
PEAK_NORM_MODE = str(PEAK_CFG.get("norm_mode", "pop_size"))
PEAK_METHODS = [str(x) for x in (PEAK_CFG.get("methods") or ["kl"])]
PEAK_TAIL_PROB = float(PEAK_CFG.get("tail_prob", 0.01))
PEAK_THRESHOLD_SCOPE = str(PEAK_CFG.get("threshold_scope", "genome"))
PEAK_MIN_WINDOW_TOTAL = float(PEAK_CFG.get("min_window_total", 0))
PEAK_MIN_CLUSTER_N = int(PEAK_CFG.get("min_cluster_n", 4))
PEAK_CONTRIB_TOP_N = int(PEAK_CFG.get("contrib_top_n", 5))
PEAK_POINT_SIZE = float(PEAK_CFG.get("point_size", 0.8))
PEAK_MAX_CONCURRENT_COVERAGE_JOBS = PEAK_CFG.get("max_concurrent_coverage_jobs")
if PEAK_MAX_CONCURRENT_COVERAGE_JOBS is None:
    PEAK_MAX_CONCURRENT_COVERAGE_JOBS = sys.maxsize
else:
    PEAK_MAX_CONCURRENT_COVERAGE_JOBS = int(PEAK_MAX_CONCURRENT_COVERAGE_JOBS)
    if PEAK_MAX_CONCURRENT_COVERAGE_JOBS < 1:
        raise ValueError("ibd_window_peaks.max_concurrent_coverage_jobs must be >= 1")
workflow.global_resources["peak_coverage_jobs"] = PEAK_MAX_CONCURRENT_COVERAGE_JOBS
_peak_custom_panels_cfg = PEAK_CFG.get("panels")
if _peak_custom_panels_cfg is None:
    PEAK_CUSTOM_PANELS = CUSTOM_PANELS
else:
    PEAK_CUSTOM_PANELS = [p for p in _peak_custom_panels_cfg if p in CUSTOM_PANELS]
PEAK_DEFAULT_PANELS = bool(PEAK_CFG.get("default_panels", True))
PEAK_IBD_MIN_L = float(PEAK_CFG.get("min_l_cm", config.get("aggregation", {}).get("ibd_params", {}).get("min_l_cm", 0)))
PEAK_IBD_MIN_LOD = float(PEAK_CFG.get("min_lod", config.get("aggregation", {}).get("ibd_params", {}).get("min_lod", 0)))
if PEAK_NORM_MODE not in ("none", "pop_size"):
    raise ValueError("ibd_window_peaks.norm_mode must be one of: none, pop_size")

include: "rules/ibd_mask.smk"
include: "rules/ibd_tot.smk"
include: "rules/cluster_ibd.smk"
include: "rules/aggregate_ibd.smk"
include: "rules/mixmodel_ibd.smk"
include: "rules/pca_ibd.smk"
include: "rules/ibd_window_peaks.smk"


rule all:
    input:
        MASK_OUTPUTS
        + IBD_TOT_OUTPUTS
        + CLUSTER_OUTPUTS
        + AGG_OUTPUTS
        + MIXMODEL_OUTPUTS
        + PCA_OUTPUTS
        + PEAK_OUTPUTS


## the core pipeline addressed on its own, in particular for `snakemake --touch
## core` after an input was regenerated with identical content and only its
## timestamp changed (see workflow/scripts/touch_core_slurm.sh).
rule core:
    input:
        MASK_OUTPUTS
        + IBD_TOT_OUTPUTS
        + CLUSTER_OUTPUTS
        + AGG_OUTPUTS
        + MIXMODEL_OUTPUTS
        + PCA_OUTPUTS
