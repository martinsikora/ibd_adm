MIX_DIAG_DISTAL_QUANTILE = float(
    config.get("mixture", {}).get("diag_distal_quantile", 0.5)
)
if MIX_DIAG_DISTAL_QUANTILE < 0 or MIX_DIAG_DISTAL_QUANTILE > 1:
    raise ValueError("mixture.diag_distal_quantile must be in [0, 1]")

# per-stratum sink test: catches a source that is an unfitted intercept rather
# than an ancestry component, absorbing misfit/drift inside the one stratum
# where the panel has no proximate source. Strata are cut from the palette
# geometry, so no metadata region column is involved.
# source-level R scale flag thresholds, as fold-change vs the panel median R.
# 2.5 is where validated cohorts start to show a real offset (Morocco 5.3x is
# confirmed offset; the Steppe/WHG/EEF axis at <2.4x is confirmed clean); 10
# separates those from the African sources at 20-500x. Panel-relative by
# construction -- see workflow/scripts/awk/mixmodel_source_r_flags.awk.
MIX_R_FLAG_WARN = float(config.get("mixture", {}).get("r_flag_warn", 2.5))
MIX_R_FLAG_SEVERE = float(config.get("mixture", {}).get("r_flag_severe", 10.0))
# per-target risk tiers built on the source R flags, on the R-corrected share
MIX_R_TARGET_PMIN = float(config.get("mixture", {}).get("r_target_pmin", 0.002))
MIX_R_TARGET_HIGH = float(config.get("mixture", {}).get("r_target_high", 0.02))
MIX_R_TARGET_MODERATE = float(config.get("mixture", {}).get("r_target_moderate", 0.05))
MIX_R_TARGET_LOW = float(config.get("mixture", {}).get("r_target_low", 0.01))
if not 0 <= MIX_R_TARGET_PMIN < 1:
    raise ValueError("mixture.r_target_pmin must be in [0, 1)")
for _k, _v in (("high", MIX_R_TARGET_HIGH), ("moderate", MIX_R_TARGET_MODERATE), ("low", MIX_R_TARGET_LOW)):
    if not 0 < _v <= 1:
        raise ValueError(f"mixture.r_target_{_k} must be in (0, 1]")
if MIX_R_FLAG_WARN <= 1:
    raise ValueError("mixture.r_flag_warn must be > 1")
if MIX_R_FLAG_SEVERE <= MIX_R_FLAG_WARN:
    raise ValueError("mixture.r_flag_severe must be > mixture.r_flag_warn")

MIX_DIAG_SINK_STRATA = int(config.get("mixture", {}).get("diag_sink_strata", 12))
MIX_DIAG_SINK_MIN_R = float(config.get("mixture", {}).get("diag_sink_min_r", 0.4))
MIX_DIAG_SINK_MIN_N = int(config.get("mixture", {}).get("diag_sink_min_n", 15))
MIX_DIAG_SINK_MIN_P = float(config.get("mixture", {}).get("diag_sink_min_p", 0.01))
MIX_DIAG_SINK_MIN_GAP = float(config.get("mixture", {}).get("diag_sink_min_gap", 0.15))
if MIX_DIAG_SINK_STRATA < 1:
    raise ValueError("mixture.diag_sink_strata must be >= 1")
if not 0 < MIX_DIAG_SINK_MIN_R <= 1:
    raise ValueError("mixture.diag_sink_min_r must be in (0, 1]")
if MIX_DIAG_SINK_MIN_N < 3:
    raise ValueError("mixture.diag_sink_min_n must be >= 3")
if not 0 <= MIX_DIAG_SINK_MIN_P <= 1:
    raise ValueError("mixture.diag_sink_min_p must be in [0, 1]")
if not 0 <= MIX_DIAG_SINK_MIN_GAP <= 2:
    raise ValueError("mixture.diag_sink_min_gap must be in [0, 2]")

