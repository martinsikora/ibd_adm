    raise ValueError("aggregation.color_map_embedding must be one of: tsne3, mds3")
COLOR_MAP_MAPPING = str(config.get("aggregation", {}).get("color_map_mapping", "radial"))
if COLOR_MAP_MAPPING not in ("radial", "pca_axes"):
    raise ValueError("aggregation.color_map_mapping must be one of: radial, pca_axes")
if COLOR_TSNE_CHROMA_MAX <= COLOR_TSNE_CHROMA_MIN:
    raise ValueError("aggregation.color_tsne_chroma_max must be > color_tsne_chroma_min")
if COLOR_TSNE_LUM_MAX <= COLOR_TSNE_LUM_MIN:
    raise ValueError("aggregation.color_tsne_lum_max must be > color_tsne_lum_min")
if COLOR_TSNE_GAMMA_C <= 0 or COLOR_TSNE_GAMMA_L <= 0:
    raise ValueError("aggregation.color_tsne_gamma_c and color_tsne_gamma_l must be > 0")
if COLOR_TSNE_HUE_SPREAD not in ("raw", "range", "rank"):
    raise ValueError("aggregation.color_tsne_hue_spread must be one of: raw, range, rank")
COLOR_TSNE_LC_SPREAD = str(config.get("aggregation", {}).get("color_tsne_lc_spread", "raw"))
if COLOR_TSNE_LC_SPREAD not in ("raw", "rank"):
    raise ValueError("aggregation.color_tsne_lc_spread must be one of: raw, rank")
