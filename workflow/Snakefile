        "sample_file": INDIVIDUALS,
        "heights": CLUSTER_HEIGHTS,
    }
}

CUSTOM_PANELS = config.get("aggregation", {}).get("panels") or []

# tvd_matrix.py keeps only donor_recipient samples on the recipient side, so a
# recipient-only cluster never reaches the TVD tree or heatmap even though its
# profile over the donor palette is well defined (aggregate_ibd.py restricts
# only the donor side). These force such clusters back in -- all of them at
# once, or by name -- with an exclude list for catch-all bins like "unassigned".
#
# Scoped PER PANEL, not global: "unassigned" (or any other pop_id) does not
# mean the same thing in every panel. In a manually curated panel it can be a
# deliberate, wholly-recipient catch-all bin (e.g. h05_g02_tier3_m's 192-sample
# "unassigned"); in the raw default clustering panel the identical pop_id is
# just cut_tree's ordinary terminal-cluster label and is mostly donor_recipient
# (165 of 198 members here) -- excluding it there would silently drop a real
# cluster from that panel's TVD tree. A panel not listed in full_cluster_pop_overrides
# gets no override at all.
_AGG_CFG = config.get("aggregation", {})
_FULL_CLUSTER_POP_OVERRIDES = _AGG_CFG.get("full_cluster_pop_overrides") or {}
if not isinstance(_FULL_CLUSTER_POP_OVERRIDES, dict):
    raise ValueError("aggregation.full_cluster_pop_overrides must be a mapping of panel name -> options")
for _panel_key, _panel_cfg in _FULL_CLUSTER_POP_OVERRIDES.items():
    _panel_cfg = _panel_cfg or {}
    for _k in ("include_pops", "exclude_pops"):
        _v = _panel_cfg.get(_k) or []
        if not isinstance(_v, list) or any("," in str(x) or "'" in str(x) for x in _v):
            raise ValueError(
                f"aggregation.full_cluster_pop_overrides.{_panel_key}.{_k} must be a YAML "
                "list of pop_ids containing no commas or quotes"
            )


def full_cluster_pop_flags(panel):
    """Extra tvd_matrix.py/make_mix_sample_map.py flags for `panel` (e.g. "default",
    or a custom panel's directory name). Panels absent from full_cluster_pop_overrides get no
    flags at all."""
    cfg = _FULL_CLUSTER_POP_OVERRIDES.get(panel) or {}
    include_pops = cfg.get("include_pops") or []
    exclude_pops = cfg.get("exclude_pops") or []
    parts = []
    if cfg.get("include_recipient_only_pops", False):
        parts.append("--include_recipient_only_pops")
    if include_pops:
        parts.append("--include_pops '" + ",".join(map(str, include_pops)) + "'")
    if exclude_pops:
        parts.append("--exclude_pops '" + ",".join(map(str, exclude_pops)) + "'")
    return " ".join(parts)


