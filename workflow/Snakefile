    raise ValueError(
        "mixture.auto_source_pick_method must be one of: tree_spread, farthest, "
        "cluster_medoids, differentiated, differentiated_spread, differentiated_unadmixed"
    )
MIX_AUTO_SOURCE_BROAD_K = int(config.get("mixture", {}).get("auto_source_broad_k", 0))
