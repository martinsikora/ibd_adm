# ---- base / gate height: there is exactly ONE default clustering panel -----
# base_height and gate_height must both be set. Equal -> the panel is a plain
# cut at that height (no gating). gate_height below base_height -> the panel is
# the sharing-gated combination of the two (workflow/scripts/r/
# cluster_cut_gated.R): most clusters keep the coarser base_height label, and
# only those with enough IBD to support it take the finer gate_height label.
# Neither height needs building elsewhere first: cut_tree carries a {height}
# wildcard, so both are cut on demand as inputs to the gate.
ENABLE_DEFAULT_PIPELINE = CLUSTER_ENABLED
if CLUSTER_ENABLED:
    _CLU_CFG = config.get("clustering", {})
    if "base_height" not in _CLU_CFG or "gate_height" not in _CLU_CFG:
        raise ValueError(
            "clustering.base_height and clustering.gate_height must both be "
            "set whenever clustering.enabled is true (equal = no gating, "
            "gate_height below base_height = gated)"
        )
    GATED_BASE_HEIGHT = str(_CLU_CFG["base_height"])
    GATED_FINE_HEIGHT = str(_CLU_CFG["gate_height"])
    try:
        _base_f, _fine_f = float(GATED_BASE_HEIGHT), float(GATED_FINE_HEIGHT)
    except ValueError:
        raise ValueError(
            "clustering.base_height and clustering.gate_height must be "
            f"numeric (got {GATED_BASE_HEIGHT!r} and {GATED_FINE_HEIGHT!r})"
        )
    if _fine_f > _base_f:
        raise ValueError(
            "clustering.gate_height must be at or below base_height (a lower "
            f"cut height is the finer one); got base={GATED_BASE_HEIGHT} "
            f"gate={GATED_FINE_HEIGHT}"
        )
    GATED_ENABLED = _fine_f != _base_f
    GATED_MIN_SHARING = float(_CLU_CFG.get("min_sharing", 250000))
    if GATED_ENABLED and GATED_MIN_SHARING < 0:
        raise ValueError("clustering.min_sharing must be >= 0")
else:
    GATED_BASE_HEIGHT = GATED_FINE_HEIGHT = ""
    GATED_ENABLED = False
    GATED_MIN_SHARING = 250000.0

def _cluster_name_slug(x):
    return re.sub(r"[^A-Za-z0-9]+", "_", str(x)).strip("_")

# IBD-vector transform tag. Kept backward-compatible: with standardize_features
# off, the tag is exactly "norm" (L2) or "raw" as before. z-score adds "zscore".
if CLUSTER_STANDARDIZE_FEATURES and CLUSTER_NORMALIZE_IBD_VECTORS:
    CLUSTER_NORM_TAG = "zscorenorm"
elif CLUSTER_STANDARDIZE_FEATURES:
    CLUSTER_NORM_TAG = "zscore"
elif CLUSTER_SCALE_FEATURES and CLUSTER_NORMALIZE_IBD_VECTORS:
    CLUSTER_NORM_TAG = "scalenorm"
elif CLUSTER_SCALE_FEATURES:
    CLUSTER_NORM_TAG = "scale"
elif CLUSTER_NORMALIZE_IBD_VECTORS:
    CLUSTER_NORM_TAG = "norm"
else:
    CLUSTER_NORM_TAG = "raw"
# distance depends only on dist_method + feature transforms (not clust_method),
# so the distance matrix is cached under this shorter, height/method-independent key
CLUSTER_DIST_NORM_TAG = (
    f"d{_cluster_name_slug(CLUSTER_DIST_METHOD)}"
    f"_n{CLUSTER_NORM_TAG}"
)
CLUSTER_OUTPUT_TAG = (
    f"{CLUSTER_DIST_NORM_TAG}"
    f"_m{_cluster_name_slug(CLUSTER_CLUST_METHOD)}"
)

# shared, height-independent intermediates live under a per-config cache dir
CLUSTER_CACHE_DIR = RESULTS_DIR + "/cluster_cache"
CLUSTER_MRAW_RDS = f"{CLUSTER_CACHE_DIR}/{PREFIX}.m_raw.rds"
CLUSTER_MD_RDS = f"{CLUSTER_CACHE_DIR}/{CLUSTER_DIST_NORM_TAG}/{PREFIX}.m_d.rds"
CLUSTER_HC_RDS = f"{CLUSTER_CACHE_DIR}/{CLUSTER_OUTPUT_TAG}/{PREFIX}.res_hc.rds"
CLUSTER_HIER_RDS = f"{CLUSTER_CACHE_DIR}/{CLUSTER_OUTPUT_TAG}/{PREFIX}.tree_hier.rds"

def cluster_panel_name(height):
    return f"cluster_h{height}_{CLUSTER_OUTPUT_TAG}"

# The single default panel's {height} wildcard value: the composite
# "{base}g{gate}" string when gated (e.g. "0.5g0.2"), or the bare base height
# otherwise. cut_tree's {height} wildcard is a plain string match, and
# cluster_plot.R reads cut_height as character, so this composite value works
# with every rule that expands over CLUSTER_HEIGHTS exactly like a numeric one
# -- it is what gated_panel_name() used to build directly, before base/gate
# height were split out of a general `heights` list.
CLUSTER_PANEL_HEIGHT = (
    f"{GATED_BASE_HEIGHT}g{GATED_FINE_HEIGHT}" if GATED_ENABLED else GATED_BASE_HEIGHT
)
CLUSTER_HEIGHTS = [CLUSTER_PANEL_HEIGHT] if ENABLE_DEFAULT_PIPELINE else []
CLUSTER_DEFAULT_PANELS = [cluster_panel_name(h) for h in CLUSTER_HEIGHTS]

def gated_panel_name():
    # kept for existing call sites (cluster_ibd.smk); now just the one panel
    return cluster_panel_name(CLUSTER_PANEL_HEIGHT)

CLUSTER_PANELS = {
