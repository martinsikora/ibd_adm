PREFIX = config["prefix"]
RESULTS_DIR = "results"
PANELS_DIR = RESULTS_DIR + "/panels"
PANELS_CFG_DIR = "config/panels"
TMPDIR = config.get("tmpdir")

if TMPDIR:
    TMPDIR = os.path.abspath(os.path.expanduser(str(TMPDIR)))
    shell.prefix(f"mkdir -p {quote(TMPDIR)} && export TMPDIR={quote(TMPDIR)} && ")


with open(config["ref"]["chromosomes"]) as _chrom_fh:
    CHROMS = [line.strip() for line in _chrom_fh if line.strip()]
if not CHROMS:
    raise ValueError(f"No chromosomes found in {config['ref']['chromosomes']}")

