COLOR_TSNE_GAMMA_L = float(config.get("aggregation", {}).get("color_tsne_gamma_l", 0.8))
COLOR_TSNE_HUE_SCALE = float(config.get("aggregation", {}).get("color_tsne_hue_scale", 1.15))
COLOR_TSNE_HUE_ROTATE = float(config.get("aggregation", {}).get("color_tsne_hue_rotate", 25))
COLOR_TSNE_HUE_SPREAD = str(config.get("aggregation", {}).get("color_tsne_hue_spread", "range"))
COLOR_MAP_SHAPES = config.get("aggregation", {}).get("color_map_shapes", list(range(16)))
if not isinstance(COLOR_MAP_SHAPES, list) or not COLOR_MAP_SHAPES:
    raise ValueError("aggregation.color_map_shapes must be a non-empty list of shape ids")
try:
    COLOR_MAP_SHAPES = [str(int(x)) for x in COLOR_MAP_SHAPES]
except (TypeError, ValueError):
    raise ValueError("aggregation.color_map_shapes must contain only integer shape ids")
COLOR_MAP_SHAPES_ARG = ",".join(COLOR_MAP_SHAPES)
