    input:
        MASK_OUTPUTS
        + IBD_TOT_OUTPUTS
        + CLUSTER_OUTPUTS
        + AGG_OUTPUTS
        + MIXMODEL_OUTPUTS
        + PCA_OUTPUTS
        + PEAK_OUTPUTS
