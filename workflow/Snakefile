    raise ValueError("mixture.auto_k_min/auto_k_max must satisfy 2 <= auto_k_min <= auto_k_max")
MIX_AUTO_SOURCE_PICK_METHOD = str(
    config.get("mixture", {}).get("auto_source_pick_method", "tree_spread")
).lower()
if MIX_AUTO_SOURCE_PICK_METHOD not in (
    "tree_spread", "farthest", "cluster_medoids", "differentiated",
