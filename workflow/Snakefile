CLUSTER_HEIGHTS = [
    str(h) for h in config.get("clustering", {}).get("heights", [])
]
CLUSTER_ENABLED = bool(config.get("clustering", {}).get("enabled", True))
CLUSTER_THREADS = int(config.get("clustering", {}).get("threads", 24))
CLUSTER_DIST_METHOD = str(config.get("clustering", {}).get("dist_method", "euclidean"))
CLUSTER_CLUST_METHOD = str(config.get("clustering", {}).get("clust_method", "ward.D2"))
CLUSTER_NORMALIZE_IBD_VECTORS = bool(
    config.get("clustering", {}).get("normalize_ibd_vectors", False)
)
CLUSTER_STANDARDIZE_FEATURES = bool(
    config.get("clustering", {}).get("standardize_features", False)
)
CLUSTER_SCALE_FEATURES = bool(
    config.get("clustering", {}).get("scale_features", False)
)
if CLUSTER_STANDARDIZE_FEATURES and CLUSTER_SCALE_FEATURES:
    raise ValueError(
        "clustering.standardize_features and clustering.scale_features are "
        "mutually exclusive (centre+scale vs scale-only)"
    )
CLUSTER_CL_SIZE = int(config.get("clustering", {}).get("cl_size", 2))
CLUSTER_DEEP_SPLIT = int(config.get("clustering", {}).get("deep_split", 3))
CLUSTER_KNN = int(config.get("clustering", {}).get("knn", 1))
CLUSTER_DEFAULT_PANEL = config.get("clustering", {}).get("default_panel", "default")
ENABLE_DEFAULT_PIPELINE = CLUSTER_ENABLED and bool(CLUSTER_HEIGHTS)

def _cluster_name_slug(x):
    return re.sub(r"[^A-Za-z0-9]+", "_", str(x)).strip("_")

# IBD-vector transform tag. Kept backward-compatible: with standardize_features
# off, the tag is exactly "norm" (L2) or "raw" as before. z-score adds "zscore".
if CLUSTER_STANDARDIZE_FEATURES and CLUSTER_NORMALIZE_IBD_VECTORS:
    CLUSTER_NORM_TAG = "zscorenorm"
elif CLUSTER_STANDARDIZE_FEATURES:
    CLUSTER_NORM_TAG = "zscore"
elif CLUSTER_SCALE_FEATURES and CLUSTER_NORMALIZE_IBD_VECTORS:
    CLUSTER_NORM_TAG = "scalenorm"
elif CLUSTER_SCALE_FEATURES:
    CLUSTER_NORM_TAG = "scale"
elif CLUSTER_NORMALIZE_IBD_VECTORS:
    CLUSTER_NORM_TAG = "norm"
else:
    CLUSTER_NORM_TAG = "raw"
# distance depends only on dist_method + feature transforms (not clust_method),
# so the distance matrix is cached under this shorter, height/method-independent key
CLUSTER_DIST_NORM_TAG = (
    f"d{_cluster_name_slug(CLUSTER_DIST_METHOD)}"
    f"_n{CLUSTER_NORM_TAG}"
)
CLUSTER_OUTPUT_TAG = (
    f"{CLUSTER_DIST_NORM_TAG}"
    f"_m{_cluster_name_slug(CLUSTER_CLUST_METHOD)}"
)

# shared, height-independent intermediates live under a per-config cache dir
CLUSTER_CACHE_DIR = RESULTS_DIR + "/cluster_cache"
CLUSTER_MRAW_RDS = f"{CLUSTER_CACHE_DIR}/{PREFIX}.m_raw.rds"
CLUSTER_MD_RDS = f"{CLUSTER_CACHE_DIR}/{CLUSTER_DIST_NORM_TAG}/{PREFIX}.m_d.rds"
CLUSTER_HC_RDS = f"{CLUSTER_CACHE_DIR}/{CLUSTER_OUTPUT_TAG}/{PREFIX}.res_hc.rds"
CLUSTER_HIER_RDS = f"{CLUSTER_CACHE_DIR}/{CLUSTER_OUTPUT_TAG}/{PREFIX}.tree_hier.rds"

def cluster_panel_name(height):
    return f"cluster_h{height}_{CLUSTER_OUTPUT_TAG}"

CLUSTER_DEFAULT_PANELS = [cluster_panel_name(h) for h in CLUSTER_HEIGHTS]

# ---- sharing-gated adaptive cut -------------------------------------------
# Combines a coarse and a fine cut of the same tree, taking the fine labels only
# where a coarse cluster carries enough IBD to support finer distinctions. See
# workflow/scripts/r/cluster_cut_gated.R for the rationale and its limits.
GATED_CFG = config.get("clustering", {}).get("gated_cut", {}) or {}
GATED_ENABLED = bool(GATED_CFG.get("enabled", False))
GATED_BASE_HEIGHT = str(GATED_CFG.get("base_height", ""))
GATED_FINE_HEIGHT = str(GATED_CFG.get("fine_height", ""))
GATED_MIN_SHARING = float(GATED_CFG.get("min_sharing", 250000))

if GATED_ENABLED:
    if not ENABLE_DEFAULT_PIPELINE:
        raise ValueError(
            "clustering.gated_cut.enabled requires the default clustering "
            "pipeline (clustering.enabled + at least one height)"
        )
    # Neither height has to appear in `heights`: cut_tree carries a {height}
    # wildcard, so requesting its clusters.tsv builds that cut on demand. Keep
    # the fine height OUT of `heights` unless you want it aggregated -- every
    # entry there also gets its own 22-chromosome aggregation, PCA and mixmodel.
    try:
        _base_f, _fine_f = float(GATED_BASE_HEIGHT), float(GATED_FINE_HEIGHT)
    except ValueError:
        raise ValueError(
            "clustering.gated_cut base_height and fine_height must be numeric "
            f"(got {GATED_BASE_HEIGHT!r} and {GATED_FINE_HEIGHT!r})"
        )
    if _fine_f >= _base_f:
        raise ValueError(
            "clustering.gated_cut.fine_height must be BELOW base_height "
            "(a lower cut height is the finer one); got "
            f"base={GATED_BASE_HEIGHT} fine={GATED_FINE_HEIGHT}"
        )
    if GATED_MIN_SHARING < 0:
        raise ValueError("clustering.gated_cut.min_sharing must be >= 0")

def gated_panel_name():
    # e.g. cluster_h0.5g0.2_dcosine_nscale_mward_D2
    return (
        f"cluster_h{GATED_BASE_HEIGHT}g{GATED_FINE_HEIGHT}_{CLUSTER_OUTPUT_TAG}"
    )

