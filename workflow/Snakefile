MIX_DIAG_DISTAL_QUANTILE = float(
    config.get("mixture", {}).get("diag_distal_quantile", 0.5)
)
if MIX_DIAG_DISTAL_QUANTILE < 0 or MIX_DIAG_DISTAL_QUANTILE > 1:
    raise ValueError("mixture.diag_distal_quantile must be in [0, 1]")

# per-stratum sink test: catches a source that is an unfitted intercept rather
# than an ancestry component, absorbing misfit/drift inside the one stratum
# where the panel has no proximate source. Strata are cut from the palette
# geometry, so no metadata region column is involved.
MIX_DIAG_SINK_STRATA = int(config.get("mixture", {}).get("diag_sink_strata", 12))
MIX_DIAG_SINK_MIN_R = float(config.get("mixture", {}).get("diag_sink_min_r", 0.4))
MIX_DIAG_SINK_MIN_N = int(config.get("mixture", {}).get("diag_sink_min_n", 15))
MIX_DIAG_SINK_MIN_P = float(config.get("mixture", {}).get("diag_sink_min_p", 0.01))
MIX_DIAG_SINK_MIN_GAP = float(config.get("mixture", {}).get("diag_sink_min_gap", 0.15))
if MIX_DIAG_SINK_STRATA < 1:
    raise ValueError("mixture.diag_sink_strata must be >= 1")
if not 0 < MIX_DIAG_SINK_MIN_R <= 1:
    raise ValueError("mixture.diag_sink_min_r must be in (0, 1]")
if MIX_DIAG_SINK_MIN_N < 3:
    raise ValueError("mixture.diag_sink_min_n must be >= 3")
if not 0 <= MIX_DIAG_SINK_MIN_P <= 1:
    raise ValueError("mixture.diag_sink_min_p must be in [0, 1]")
if not 0 <= MIX_DIAG_SINK_MIN_GAP <= 2:
    raise ValueError("mixture.diag_sink_min_gap must be in [0, 2]")

